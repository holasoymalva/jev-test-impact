{
  "name": "jev-test-impact",
  "version": "0.1.0",
  "description": "Run only the tests that matter. Test impact analysis powered by Jev.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jev-test-impact": "./dist/cli/index.js",
    "jti": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && pnpm action:bundle",
    "action:bundle": "ncc build action/index.ts -o dist/action --minify",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "dev": "tsx src/cli/index.ts",
    "demo:generate": "tsx scripts/generate-demo.ts"
  },
  "dependencies": {
    "@actions/core": "^2.0.1",
    "@actions/github": "^6.0.1",
    "citty": "^0.1.6",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^24.5.2",
    "@vercel/ncc": "^0.38.3",
    "tsdown": "^0.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.5.0"
}
